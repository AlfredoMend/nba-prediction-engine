# Copy to .env and adjust. All values are optional.

# Data source: "sportsdataverse" (ESPN data on GitHub, default), "nba_api" (stats.nba.com)
# or "synthetic" (offline demo league)
NBA_DATA_SOURCE=sportsdataverse

# Override "today" (YYYY-MM-DD) for reproducible runs
# NBA_TODAY=2026-10-26

# Storage locations
# NBA_DB_PATH=data/nba.duckdb
# NBA_MODELS_DIR=models_store

# Monte Carlo runs per game and walk-forward retrain cadence (days)
NBA_N_SIMS=10000
NBA_GAME_RETRAIN_DAYS=7
NBA_PROP_RETRAIN_DAYS=28

# The Odds API key for live spreads/totals (https://the-odds-api.com). Leave blank to use data/lines.csv only.
ODDS_API_KEY=
# Books to pull player props from (The Odds API bookmaker keys, comma-separated), e.g. novig,draftkings,fanduel
ODDS_PROP_BOOKMAKERS=
